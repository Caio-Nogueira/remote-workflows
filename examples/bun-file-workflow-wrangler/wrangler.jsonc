{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remote-workflows-wrangler-bun-file-relay",
  "main": "src/relay.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "REMOTE_WORKFLOW_PATH": "/write-file"
  },
  "vpc_services": [
    {
      "binding": "REMOTE_WORKFLOW_SERVER",
      "service_id": "<VPC_SERVICE_ID>"
    }
  ],
  "services": [
    {
      "binding": "SERVICE_BINDING",
      "service": "remote-workflows-wrangler-bun-file-relay",
      "entrypoint": "ServiceBinding"
    }
  ],
  "workflows": [
    {
      "binding": "REMOTE_WORKFLOW_REGISTRATION",
      "name": "WranglerBunFileWorkflow",
      "class_name": "RemoteWorkflow"
    }
  ]
}
