{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vaultwarden-backup-relay",
  "main": "src/relay.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "REMOTE_WORKFLOW_PATH": "/vaultwarden-backup"
  },
  "vpc_services": [
    {
      "binding": "REMOTE_WORKFLOW_SERVER",
      "service_id": "<VPC_SERVICE_ID>"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VAULTWARDEN_BACKUPS",
      "bucket_name": "vaultwarden-backup"
    }
  ],
  "workflows": [
    {
      "binding": "REMOTE_WORKFLOW_REGISTRATION",
      "name": "VaultwardenBackupWorkflow",
      "class_name": "RemoteWorkflow",
      "schedules": ["0 */6 * * *"]
    }
  ]
}
